#!/bin/sh
# Branding Kons-OS: nazwa systemu, hostname, powitanie, tapeta.
set -e

KONS_VERSION="0.1.0"
[ -f /etc/kons-version ] && KONS_VERSION="$(cat /etc/kons-version)"

# --- Nazwa systemu (os-release) ---
cat > /usr/lib/os-release <<EOR
PRETTY_NAME="Kons-OS ${KONS_VERSION}"
NAME="Kons-OS"
VERSION_ID="${KONS_VERSION}"
VERSION="${KONS_VERSION} (na bazie Debian 13 trixie)"
VERSION_CODENAME=trixie
ID=kons-os
ID_LIKE=debian
HOME_URL="https://github.com/conrad3k/kons-os"
SUPPORT_URL="https://github.com/conrad3k/kons-os/issues"
BUG_REPORT_URL="https://github.com/conrad3k/kons-os/issues"
EOR
ln -sf ../usr/lib/os-release /etc/os-release

# --- Ekran logowania w konsoli ---
cat > /etc/issue <<'EOR'
Kons-OS \r (\l)

EOR
echo "Kons-OS" > /etc/issue.net

cat > /etc/motd <<'EOR'

  Witaj w Kons-OS!  Wpisz "kons-info", żeby zobaczyć informacje o systemie.

EOR

# --- Hostname ---
echo "kons-os" > /etc/hostname

# --- Tapeta: ustawiamy Kons-OS jako domyślne tło (desktop-base) ---
WALL=/usr/share/backgrounds/kons-os/kons-wallpaper.png
if [ -f "$WALL" ]; then
    update-alternatives --install /usr/share/images/desktop-base/desktop-background \
        desktop-background "$WALL" 100
    update-alternatives --set desktop-background "$WALL"
fi

# --- Domyślny wygląd XFCE dla nowych użytkowników ---
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'EOR'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Arc-Dark"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Noto Sans 10"/>
    <property name="MonospaceFontName" type="string" value="Noto Sans Mono 10"/>
  </property>
</channel>
EOR
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml <<'EOR'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Arc-Dark"/>
  </property>
</channel>
EOR

# --- Ekran logowania LightDM ---
mkdir -p /etc/lightdm/lightdm-gtk-greeter.conf.d
cat > /etc/lightdm/lightdm-gtk-greeter.conf.d/50-kons-os.conf <<EOR
[greeter]
background=${WALL}
theme-name=Arc-Dark
icon-theme-name=Papirus-Dark
font-name=Noto Sans 11
EOR
