# Kons K1 — zamknięte jądro k1.efi (M6d, ADR 0022). Dopisywane do k1.config przez scripts/zbuduj-k1efi.sh
# (@LINIA@ i @LISTA@ wstawia skrypt). Jeden plik = cały system: linia poleceń i initramfs (z rdzen.squashfs)
# są w jądrze, które podpisujemy — program ładujący nie może ich zmienić ani dołożyć własnego initramfs.
#
# Linia poleceń tylko z jądra (GRUB-owa jest pomijana); zawiera noinitrd — stub EFI nie wczyta initrd
# podsuniętego przez program ładujący (LoadFile2), a bez protokołu „handover” (wyłączony w k1.config)
# program ładujący nie ma innej drogi, by go przekazać.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="@LINIA@"
CONFIG_CMDLINE_OVERRIDE=y
# initramfs (/init = k1-initramfs) i obraz rdzenia (/rdzen.squashfs, k1.rdzen=wbudowany) wbudowane;
# bez osobnej kompresji (całe jądro i tak jest skompresowane, a SquashFS — już).
CONFIG_INITRAMFS_SOURCE="@LISTA@"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
