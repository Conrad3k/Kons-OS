# Wersja jądra Linux dla K1 (linia LTS) — jedyne źródło prawdy.
# Zmiana wersji: zob. jadro/README.md („Aktualizacja jądra”).
K1_JADRO_WERSJA=7.3.5
K1_JADRO_SHA256=8f293f83d54f0b7b9be56863ebc5e4ea79d73e530b4ae55c572be97ef39f0990
K1_JADRO_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x

# Pliki od producentów kart Wi-Fi (0.9.1, ADR 0041): wydanie linux-firmware (tag w repozytorium kernel.org), pliki
# pobierane pojedynczo, każdy z sumą w jadro/oprogramowanie-kart.txt.
K1_PLIKI_KART_WERSJA=20261019
K1_PLIKI_KART_URL=https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain
# Zapas: to samo repozytorium na gitlab.com (tam pracują opiekunowie linux-firmware) — suma i tak jest sprawdzana.
K1_PLIKI_KART_ZAPAS=https://gitlab.com/kernel-firmware/linux-firmware/-/raw
# Baza przepisów radiowych (wireless-regdb): archiwum z sumą (zgodną z sha256sums.asc wydania).
K1_REGDB_WERSJA=2026.09.03
K1_REGDB_SHA256=b22e0901227b820cd1c280abe681a15b773a5103a5e10dc442e94ebb34cbf58d
K1_REGDB_URL=https://cdn.kernel.org/pub/software/network/wireless-regdb
