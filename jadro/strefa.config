# Konfiguracja jądra STREFY (0.10.0, ADR 0042) — fragment nakładany na `make allnoconfig` tych samych źródeł co
# jądro K1 (jadro/wersja.env: jedna wersja jądra). To jądro działa W mikro-maszynie (gość), nie w K1: uruchamia je VMM
# `strefa` wprost (64-bitowy protokół startu Linuksa, bez firmware), z urządzeniami virtio-mmio opisanymi w linii
# poleceń. Wszystko, czego tu nie ma, jest WYŁĄCZONE; scripts/zbuduj-jadro.sh sprawdza, że każda linia weszła.
# Zasady jak w jadro/k1.config (każda linia z komentarzem), ale to inny świat: obce programy strefy (krok 2) mogą
# potrzebować rzeczy, których K1 nie ma (przestrzenie nazw dla sandboxa przeglądarki, JIT) — granicą jest maszyna.

# --- Podstawa ---
# EXPERT: pozwala wyłączyć to, co bez niego jest wymuszone (TTY, VT, …).
CONFIG_EXPERT=y
CONFIG_64BIT=y
# SMP: strefa przeglądarki dostanie kilka procesorów (krok 2); procesory z tablicy MP od VMM (bez ACPI).
CONFIG_SMP=y
CONFIG_NR_CPUS=8
# Kompresja: ZSTD, jak jądro K1 (mniejszy plik w rdzeniu); rozpakowuje się samo w pamięci gościa.
CONFIG_KERNEL_ZSTD=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_BINFMT_ELF=y
# 0.10.0 krok 2 (ADR 0043): przeglądarka (Firefox ESR z Debiana, glibc) potrzebuje tego, co zwykły Linux ma domyślnie,
# a allnoconfig z EXPERT wyłącza: blokad plików (SQLite profilu), membarrier i rseq (glibc, wątki), /proc/sys,
# inotify (GLib i GTK śledzą pliki), zegarów wysokiej rozdzielczości i bezczynności bez tyknięć (mniej pracy VMM).
CONFIG_FILE_LOCKING=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
# 7.x: dawne PROC_SYSCTL to SYSCTL (fs/proc/Kconfig).
CONFIG_SYSCTL=y
# TSX wyłączone jak w jądrze K1 (w 7.x allnoconfig wybiera „auto”).
CONFIG_X86_INTEL_TSX_MODE_OFF=y
CONFIG_INOTIFY_USER=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
# Sandbox przeglądarki (T8): procesy treści stron w osobnych przestrzeniach nazw (użytkownik, procesy, sieć, IPC,
# nazwa hosta) z filtrem seccomp. W jądrze STREFY, nie K1 — jądro K1 dalej bez USER_NS (ADR 0042 T4).
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Bez modułów, hibernacji, kexec — gość startuje zawsze od nowa z obrazu tylko do odczytu.
# CONFIG_MODULES is not set
# CONFIG_HIBERNATION is not set
# SWAP + ZRAM (0.10.0 krok 3, S26): pamięć kompresowana — urządzenie wymiany W pamięci gościa (zram, kompresja lz4,
# szybka), nigdy na dysku: rzadko używane strony zajmują ok. 1/3 miejsca, więc ciężkie strony mieszczą się w pamięci
# strefy, zamiast kończyć przeglądarkę (na IdeaPadzie z 4 GB okno znikało). Gość i tak nie bierze od K1 więcej niż
# pamięć z wiersza K1_STREFY. Jądro K1 dalej bez swapu (niezmiennik 3) — to jądro strefy. Włącza gosc (pamiec.c).
CONFIG_SWAP=y
# VM_EVENT_COUNTERS: liczniki w /proc/vmstat, w tym „oom_kill” — po nim gosc wie, że jądro strefy zabiło proces z braku
# pamięci (K1 mówi wtedy użytkownikowi dlaczego; przebieg CI 114: bez tej opcji licznika nie było). Za EXPERT.
CONFIG_VM_EVENT_COUNTERS=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_KEXEC is not set
# CONFIG_COREDUMP is not set
# CONFIG_IO_URING is not set
# CONFIG_BPF_SYSCALL is not set

# --- Gość KVM ---
# HYPERVISOR_GUEST, PARAVIRT, KVM_GUEST: wykrycie KVM, zegar kvmclock (czas gościa od K1, bez emulacji zegarów).
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# X86_X2APIC: lokalny APIC przez MSR zamiast okna MMIO (pod KVM wolno bez IRQ_REMAP: arch/x86/kernel/kvm.c). Koniec
# przerwania (EOI) to wtedy zapis MSR, nie MMIO, które KVM musiałby emulować — szybciej, a w emulacji QEMU 8.2 (testy)
# emulacja MMIO tuż po przerwaniu kończyła się błędem KVM_INTERNAL_ERROR_DELIVERY_EV (ADR 0042, T10).
CONFIG_X86_X2APIC=y

# --- Urządzenia virtio (ADR 0042 T2): tylko przez virtio-mmio, bez PCI i ACPI ---
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
# VIRTIO_MMIO_CMDLINE_DEVICES: urządzenia opisane w linii poleceń („virtio_mmio.device=4K@0xd0000000:5”) — VMM
# nie musi udawać żadnej magistrali ani tablic ACPI/DT.
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# BLK: obraz strefy (SquashFS, tylko do odczytu). Kolejka bloków potrzebuje BLOCK.
CONFIG_BLOCK=y
# BLK_DEV: menu sterowników dysków (samo nie dodaje kodu).
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
# CONSOLE: log gościa (hvc0) do VMM. Wymaga TTY; bez VT (żadnej konsoli tekstowej) i bez pty.
CONFIG_TTY=y
CONFIG_VIRTIO_CONSOLE=y
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_SERIAL_8250 is not set
# BALLOON (0.10.1 krok 2, ADR 0044): balon — pamięć strefy według potrzeby. Gość ma od startu całą górną granicę, ale
# wolne bloki zgłasza VMM-owi (PAGE_REPORTING: bloki 2 MiB ok. 2 s po zwolnieniu, mm/page_reporting.c), a ten oddaje je
# K1; na prośbę K1 gość oddaje strony do balonu (BALLOON — do 6.18 MEMORY_BALLOON). Obie wybiera sam VIRTIO_BALLOON
# (drivers/virtio/Kconfig).
CONFIG_VIRTIO_BALLOON=y
CONFIG_BALLOON=y
CONFIG_PAGE_REPORTING=y
# RNG: losowość od K1 (getrandom w strefie, TLS przeglądarki w kroku 2).
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# INPUT: klawiatura i mysz (tablet, położenie bezwzględne) od ekranu K1 przez VMM; evdev dla programu gosc.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
# Bez sterowników PS/2 i ich kontrolera: wejście tylko przez virtio-input.
# CONFIG_SERIO is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# DRM_VIRTIO_GPU (T6): obraz 2D — gość rysuje procesorem, VMM kopiuje zmiany do okna K1. KMS wprost (default y,
# który allnoconfig wyłącza). Bez emulacji fbdev i konsoli na ekranie.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# VSOCK: kanał sterujący z VMM („gotowa”, „zamknij”) i połączenia przeglądarki (przekaźnik → VMM → łącznik, ADR 0043
# T9). Gniazda wymagają NET.
CONFIG_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# UNIX: Wayland (przeglądarka ↔ kompozytor) i komunikacja między procesami przeglądarki.
CONFIG_UNIX=y
# INET (ADR 0043 T9): tylko pętla zwrotna 127.0.0.1 — przeglądarka łączy się z przekaźnikiem (SOCKS5, port 1080).
# Strefa nie ma karty sieciowej (bez PCI, bez virtio-net), więc nie ma adresu w żadnej sieci; bez IPv6.
CONFIG_INET=y
# CONFIG_IPV6 is not set
# CONFIG_PCI is not set
# CONFIG_ACPI is not set

# DEVMEM bez STRICT_DEVMEM: root gościa może dotknąć pamięci i rejestrów swojej maszyny — i tak wszystko w niej
# do niego należy (granicą jest maszyna, VMM sprawdza każdą prośbę). Testy negatywne (gosc, tryby 1–4) udają przez
# /dev/mem gościa, który przejął własne jądro.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# --- Systemy plików ---
# PROC_FS, SYSFS: programy w strefie (gosc, w kroku 2 przeglądarka) czytają /proc i /sys.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# DEVTMPFS (+ montowanie na /dev po starcie): węzły urządzeń bez udev.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
# SQUASHFS z zstd: obraz strefy (ten sam format co rdzeń K1).
# MISC_FILESYSTEMS: menu, w którym jest SquashFS.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
# XZ: obraz przeglądarki (0.10.0 krok 2) — o ok. 10 % mniejszy niż zstd, a rdzeń z nim trzymany w pamięci i w miejscu
# A/B (128 MiB) — każdy MiB się liczy (ADR 0043, S12).
CONFIG_SQUASHFS_XZ=y
# XZ_DEC_X86: filtr BCJ dla kodu x86 (mksquashfs -Xbcj x86) — kod maszynowy kompresuje się wtedy o kilka % lepiej;
# bez niego jądro nie rozpakuje obrazu („xz decompression failed”). Za EXPERT, allnoconfig go wyłącza.
CONFIG_XZ_DEC_X86=y
# Szybszy start przeglądarki (0.10.0 krok 3, S30): bloki obrazu (1 MiB, xz) rozpakowywane wprost do pamięci podręcznej
# stron (cały blok naraz — bez pośredniego bufora, w którym przy losowym czytaniu libxul ten sam blok był rozpakowywany
# wiele razy) i na każdym procesorze strefy osobno (domyślnie jeden wątek rozpakowywania na cały obraz).
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
# EXT4_FS: dysk sesji, która pamięta (0.10.0 krok 5, ADR 0042 T11) — drugie urządzenie virtio-blk (/dev/vdb), ext4
# z dziennikiem (przerwane wyłączenie naprawia sam gość przy montowaniu). Pusty dysk robi budowa (mke2fs), więc w
# strefie nie ma mkfs. Wybiera JBD2 i CRC32 (sumy metadanych: biblioteka, bez CRYPTO). Bez EXT4_FS_SECURITY i ACL.
CONFIG_EXT4_FS=y
# CONFIG_SQUASHFS_ZLIB is not set
# CONFIG_SQUASHFS_XATTR is not set
