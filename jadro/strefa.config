# Konfiguracja jądra STREFY (0.10.0, ADR 0042) — fragment nakładany na `make allnoconfig` tych samych źródeł co
# jądro K1 (jadro/wersja.env: jedna wersja jądra). To jądro działa W mikro-maszynie (gość), nie w K1: uruchamia je VMM
# `strefa` wprost (64-bitowy protokół startu Linuksa, bez firmware), z urządzeniami virtio-mmio opisanymi w linii
# poleceń. Wszystko, czego tu nie ma, jest WYŁĄCZONE; scripts/zbuduj-jadro.sh sprawdza, że każda linia weszła.
# Zasady jak w jadro/k1.config (każda linia z komentarzem), ale to inny świat: obce programy strefy (krok 2) mogą
# potrzebować rzeczy, których K1 nie ma (przestrzenie nazw dla sandboxa przeglądarki, JIT) — granicą jest maszyna.

# --- Podstawa ---
# EXPERT: pozwala wyłączyć to, co bez niego jest wymuszone (TTY, VT, …).
CONFIG_EXPERT=y
CONFIG_64BIT=y
# SMP: strefa przeglądarki dostanie kilka procesorów (krok 2); procesory z tablicy MP od VMM (bez ACPI).
CONFIG_SMP=y
CONFIG_NR_CPUS=8
# Kompresja: ZSTD, jak jądro K1 (mniejszy plik w rdzeniu); rozpakowuje się samo w pamięci gościa.
CONFIG_KERNEL_ZSTD=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_BINFMT_ELF=y
# Bez modułów, swapu, hibernacji, kexec — gość startuje zawsze od nowa z obrazu tylko do odczytu.
# CONFIG_MODULES is not set
# CONFIG_SWAP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_COREDUMP is not set
# CONFIG_IO_URING is not set
# CONFIG_BPF_SYSCALL is not set

# --- Gość KVM ---
# HYPERVISOR_GUEST, PARAVIRT, KVM_GUEST: wykrycie KVM, zegar kvmclock (czas gościa od K1, bez emulacji zegarów).
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# X86_X2APIC: lokalny APIC przez MSR zamiast okna MMIO (pod KVM wolno bez IRQ_REMAP: arch/x86/kernel/kvm.c). Koniec
# przerwania (EOI) to wtedy zapis MSR, nie MMIO, które KVM musiałby emulować — szybciej, a w emulacji QEMU 8.2 (testy)
# emulacja MMIO tuż po przerwaniu kończyła się błędem KVM_INTERNAL_ERROR_DELIVERY_EV (ADR 0042, T10).
CONFIG_X86_X2APIC=y

# --- Urządzenia virtio (ADR 0042 T2): tylko przez virtio-mmio, bez PCI i ACPI ---
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
# VIRTIO_MMIO_CMDLINE_DEVICES: urządzenia opisane w linii poleceń („virtio_mmio.device=4K@0xd0000000:5”) — VMM
# nie musi udawać żadnej magistrali ani tablic ACPI/DT.
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# BLK: obraz strefy (SquashFS, tylko do odczytu). Kolejka bloków potrzebuje BLOCK.
CONFIG_BLOCK=y
# BLK_DEV: menu sterowników dysków (samo nie dodaje kodu).
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
# CONSOLE: log gościa (hvc0) do VMM. Wymaga TTY; bez VT (żadnej konsoli tekstowej) i bez pty.
CONFIG_TTY=y
CONFIG_VIRTIO_CONSOLE=y
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_SERIAL_8250 is not set
# RNG: losowość od K1 (getrandom w strefie, TLS przeglądarki w kroku 2).
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# INPUT: klawiatura i mysz (tablet, położenie bezwzględne) od ekranu K1 przez VMM; evdev dla programu gosc.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
# Bez sterowników PS/2 i ich kontrolera: wejście tylko przez virtio-input.
# CONFIG_SERIO is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# DRM_VIRTIO_GPU (T6): obraz 2D — gość rysuje procesorem, VMM kopiuje zmiany do okna K1. KMS wprost (default y,
# który allnoconfig wyłącza). Bez emulacji fbdev i konsoli na ekranie.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# VSOCK: kanał sterujący z VMM („gotowa”, „zamknij”), w kroku 2 także połączenia przeglądarki. Gniazda wymagają NET;
# bez INET — strefa nie ma karty sieciowej ani adresów (ADR 0042, T9 w kroku 2).
CONFIG_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# CONFIG_INET is not set
# CONFIG_PCI is not set
# CONFIG_ACPI is not set

# DEVMEM bez STRICT_DEVMEM: root gościa może dotknąć pamięci i rejestrów swojej maszyny — i tak wszystko w niej
# do niego należy (granicą jest maszyna, VMM sprawdza każdą prośbę). Testy negatywne (gosc, tryby 1–4) udają przez
# /dev/mem gościa, który przejął własne jądro.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# --- Systemy plików ---
# PROC_FS, SYSFS: programy w strefie (gosc, w kroku 2 przeglądarka) czytają /proc i /sys.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# DEVTMPFS (+ montowanie na /dev po starcie): węzły urządzeń bez udev.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
# SQUASHFS z zstd: obraz strefy (ten sam format co rdzeń K1).
# MISC_FILESYSTEMS: menu, w którym jest SquashFS.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
# CONFIG_SQUASHFS_ZLIB is not set
# CONFIG_SQUASHFS_XATTR is not set
