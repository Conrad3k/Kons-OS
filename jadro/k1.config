# Konfiguracja jądra K1 — fragment nakładany na `make allnoconfig`.
# Wszystko, czego tu nie ma, jest WYŁĄCZONE. Skrypt scripts/zbuduj-jadro.sh sprawdza, że każda
# linia poniżej znalazła się w wynikowym .config (Kconfig po cichu pomija opcje z niespełnionymi
# zależnościami). Nazwy opcji sprawdzone w źródłach 6.18.60 (pliki Kconfig*).

# --- Podstawa (EXPERT pozwala wyłączyć rzeczy, które bez niego są wymuszone) ---
CONFIG_EXPERT=y
# Kompresja jądra: ZSTD (0.9.1) — z plikami producentów kart Wi-Fi bzImage z gzip miał 20 MB; ZSTD ściska lepiej
# i rozpakowuje się szybciej niż gzip (init/Kconfig). Wymaga programu zstd przy budowie.
CONFIG_KERNEL_ZSTD=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_KALLSYMS=y
CONFIG_BINFMT_ELF=y
# Brak skryptów #! (żadnych interpreterów w świecie natywnym), brak binfmt_misc.
# CONFIG_BINFMT_SCRIPT is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_COREDUMP is not set
# CONFIG_ELF_CORE is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_FHANDLE is not set
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_BPF_SYSCALL is not set
# PERF_EVENTS: na x86 wymuszone (arch/x86/Kconfig: select PERF_EVENTS) — ograniczamy sysctl i seccomp (RYZYKA.md).
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SWAP is not set
# CONFIG_MODULES is not set

# --- LSM: Landlock + Yama + lockdown (ADR 0003) ---
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_LSM="landlock,lockdown,yama"
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Jądro nie uruchamia żadnych programów pomocniczych (modprobe, hotplug, poweroff, request-key…).
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""

# --- Wzmocnienia (lista KSPP, sprawdzana narzędziem kernel-hardening-checker) ---
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_BUCKETS=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_KFENCE=y
CONFIG_UBSAN=y
CONFIG_UBSAN_TRAP=y
CONFIG_UBSAN_BOUNDS=y
# UBSAN_LOCAL_BOUNDS tylko z Clangiem (def_bool UBSAN_ARRAY_BOUNDS && UBSAN_TRAP), budujemy GCC.
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536
CONFIG_SCHED_CORE=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_VIRTUAL=y
CONFIG_WERROR=y
# Wtyczki GCC (pakiet gcc-13-plugin-dev): czyszczenie stosu jądra po syscallu, dodatkowa entropia.
# RANDSTRUCT celowo nie: losowe ziarno przy każdym buildzie kłóci się z powtarzalnym buildem (RYZYKA.md).
CONFIG_GCC_PLUGINS=y
CONFIG_KSTACK_ERASE=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_COMPAT_BRK is not set
CONFIG_PROC_MEM_NO_FORCE=y
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set

# --- Ochrona przed atakami na procesor (allnoconfig domyślnie je WYŁĄCZA) ---
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SLS=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_TSA=y
# MITIGATION_VMSCAPE (0.10.0, ADR 0042): gość nie może atakować VMM (strefa) przewidywaniem skoków — wraca z KVM.
CONFIG_MITIGATION_VMSCAPE=y

# --- Systemy plików i start (ADR 0004) ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
# Initramfs bez kompresji: mniej kodu w jądrze.
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_SAFE=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
# CONFIG_SQUASHFS_ZLIB is not set
# CONFIG_SQUASHFS_XATTR is not set
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
# PID_NS: sysctl vm.memfd_noexec jest rejestrowany tylko z PID_NS (kernel/pid_namespace.c);
# przestrzenie PID przydadzą się w M3/M7. Przestrzenie użytkownika (USER_NS) — decyzja w M7.
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
# CONFIG_USER_NS is not set

# --- Sprzęt: maszyna QEMU (M1) ---
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_DISABLE_PCI_DMA=y
# 0.7.0 (M6d, ADR 0022): zmienne UEFI dla nadzorcy — stan Secure Boot i wpisanie klucza K1 (MokNew/MokAuth
# dla MokManagera shima). efivarfs montuje tylko nadzorca, na chwilę; usługi w klatkach go nie widzą.
CONFIG_EFIVAR_FS=y
CONFIG_RESET_ATTACK_MITIGATION=y
# IOMMU: ochrona przed atakami DMA na prawdziwym sprzęcie (Thunderbolt, karty PCIe).
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# --- Grafika i wejście (M2, ADR 0006): tylko KMS, bez fbdev/fbcon ---
# bochs = karta „stdvga” maszyny QEMU (-vga std). Jedyny użytkownik: proces ekran (DRM master).
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FB is not set
# Klawiatura i mysz PS/2 (kontroler i8042 — QEMU i wiele laptopów), zdarzenia przez evdev.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
# CONFIG_INPUT_MOUSEDEV is not set
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y

# --- M4 (ADR 0008/0010): zegar, grafika z firmware, start z obrazu ISO ---
# Typy pamięci procesora (0.5.4): bez PAT pamięć obrazu z firmware (simpledrm: ioremap_wc) jest
# mapowana bez buforowania zapisu (UC) — na ThinkPadzie X230 cały pulpit się zacinał. PAT wymaga MTRR.
CONFIG_MTRR=y
CONFIG_X86_PAT=y
# Zegar sprzętowy PC (CMOS) → czas systemowy przy starcie (zegar na pasku).
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
# 0.9.0 krok 8: /dev/rtc0 — nadzorca zapisuje zegar sprzętowy po czasie z internetu (RTC_SET_TIME); usługi go nie widzą.
CONFIG_RTC_INTF_DEV=y
# Obraz z firmware (UEFI GOP / VESA): simpledrm — maszyny wirtualne (VirtualBox, VMware) i laptopy.
# Na QEMU -vga std sterownik bochs przejmuje kartę od simpledrm (aperture helpers).
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# --- M4.1: karta graficzna VMware SVGA II — VirtualBox („VMSVGA”, domyślna dla Linuksa) i VMware ---
# Daje listę rozdzielczości do wyboru w Ustawieniach (simpledrm ma tylko tryb z firmware).
# HYPERVISOR_GUEST: wymagane przez vmwgfx (wykrywanie hiperwizora); bez PARAVIRT, KVM_GUEST i Xen.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_DRM_VMWGFX=y
# Obraz ISO: rdzeń SquashFS jest w initramfs i montowany przez urządzenie loop (k1.rdzen=wbudowany).
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0

# --- M5a (ADR 0013): dyski i USB — VirtualBox, QEMU i ThinkPad X230 (pierwszy laptop) ---
# Dyski SATA (kontroler AHCI: X230, VirtualBox, QEMU q35) i NVMe (nowsze laptopy, VirtualBox).
# Dysk SATA i pendrive są w Linuksie „dyskami SCSI” (sd*). Bez napędów CD (SR), bez /dev/sg* i bsg,
# bez rozszerzeń ATA (ACPI, port multiplier, stare IDE). Dysk otwiera tylko nadzorca (od M5d).
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# CONFIG_BLK_DEV_SR is not set
# CONFIG_CHR_DEV_SG is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_SATA_PMP is not set
# CONFIG_ATA_SFF is not set
CONFIG_BLK_DEV_NVME=y
# Tablice partycji: tylko GPT (partycja danych „K1-DANE” od M5d). Bez parsera MBR i innych
# formatów — mniej kodu jądra czytającego obce nośniki (stary MBR widać jako cały dysk).
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
# CONFIG_MSDOS_PARTITION is not set
# USB: xHCI (USB 3), EHCI (USB 2 — w X230 port żółty i urządzenia wewnętrzne), OHCI (USB 1.1 —
# VirtualBox bez Extension Packa). Tylko klawiatury/myszy (HID generic) i pamięci USB (mass storage);
# bez sterowników producentów, bez surowego dostępu (hidraw, hiddev) i bez UAS.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_STORAGE=y
# CONFIG_USB_UAS is not set
# CONFIG_USB_ANNOUNCE_NEW_DEVICES is not set
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# CONFIG_HIDRAW is not set
# CONFIG_USB_HIDDEV is not set
# Bateria i zasilacz (0.5.3): sterowniki ACPI + Embedded Controller (EC) — przez EC laptopy (np.
# ThinkPad X230) podają stan baterii; bez EC metody ACPI baterii nie działają. Stan czyta tylko
# nadzorca (sysfs power_supply) i wysyła powłoce. Bez hwmon i debugfs EC.
CONFIG_ACPI_EC=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y

# --- Zarządzanie energią procesora (0.8.6, audyt przed 0.9) ---
# Do 0.8.5 nie było go wcale (allnoconfig): każdy procesor dostawał 250 przerwań zegara na sekundę także
# bez pracy, spał tylko w najpłytszym stanie (HLT) i nie zmieniał częstotliwości — laptop grzał się i zużywał
# baterię bez potrzeby, a bez turbo był wolniejszy pod obciążeniem. Żaden program K1 tym nie steruje:
# jądro robi to samo. W QEMU (TCG) tych sterowników nie widać — efekt sprawdza się na sprzęcie (Zasoby: pobór mocy).
# NO_HZ_IDLE: bezczynny procesor nie dostaje przerwań zegara (kernel/time/Kconfig, wybór zamiast HZ_PERIODIC).
CONFIG_NO_HZ_IDLE=y
# HIGH_RES_TIMERS: poll() i nanosleep() dokładniejsze niż takt 4 ms — ekran bez page flip (simpledrm, X230)
# składa klatki co 16,7 ms (60 na sekundę), a nie co 20 ms.
CONFIG_HIGH_RES_TIMERS=y
# CPU_IDLE + INTEL_IDLE: głębokie stany uśpienia procesorów Intel (X230, Ivy Bridge: tabela idle_cpu_ivb
# w drivers/idle/intel_idle.c); governor „menu” wybiera Kconfig sam, gdy jest NO_HZ_IDLE.
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
# CPU_FREQ + X86_INTEL_PSTATE: częstotliwość i turbo procesorów Intel od Sandy Bridge (drivers/cpufreq/
# intel_pstate.c); bez HWP (X230) działa jako intel_cpufreq z governorem schedutil — domyślnym dla PSTATE i SMP.
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
# ACPI_PROCESSOR (wybiera go też INTEL_PSTATE): stany uśpienia z tablic ACPI dla procesorów, których intel_idle
# nie zna (np. AMD), i chłodzenie pasywne; wybiera THERMAL.
CONFIG_ACPI_PROCESSOR=y
# ACPI_THERMAL: strefy temperatury z ACPI. Przy temperaturze krytycznej jądro wyłącza komputer; K1 nie ma
# programu „poweroff” (STATIC_USERMODEHELPER_PATH="" — kernel/umh.c udaje wtedy sukces), więc wyłączenie
# wymusza dopiero THERMAL_EMERGENCY_POWEROFF_DELAY_MS > 0 (kernel/reboot.c: hw_failure_emergency_schedule).
CONFIG_ACPI_THERMAL=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=1000

# Brak wirtualnych terminali i pseudoterminali (§7: brak TTY i devpts).
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# NET jest wymagane przez SECCOMP_FILTER (arch/Kconfig: depends on ... && NET; filtr używa kodu BPF z net/).
# Gniazda UNIX (M3, ADR 0007): kanały między usługami (socketpair od nadzorcy, SCM_RIGHTS, SO_PASSCRED) — bez
# gniazd w systemie plików (usługi nie mają do niego dostępu).
CONFIG_NET=y
CONFIG_UNIX=y

# --- 0.9.0 Sieć (ADR 0039): tylko IPv4 po kablu; nic w K1 nie nasłuchuje ---
# Gniazdo sieciowe otwiera tylko nadzorca (root); żadna klatka nie ma wywołania socket (seccomp, test t_proby).
# INET: IPv4 z TCP i UDP (net/ipv4; TCP i UDP nie dają się wyłączyć osobno). Bez IPv6 (T2: „Później”, z ADR),
# bez zapory netfilter (T3: K1 nie nasłuchuje, ICMP wyłączone sysctl w init), bez multicastu, routingu
# zaawansowanego, IPsec (XFRM), tuneli i autokonfiguracji z linii poleceń (IP_PNP).
CONFIG_INET=y
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_PNP is not set
# CONFIG_XFRM_USER is not set
# CONFIG_INET_DIAG is not set
# SYN cookies: zalecenie KSPP (sysctl net.ipv4.tcp_syncookies=1 w init) — zalew SYN nie wyczerpuje pamięci jądra.
CONFIG_SYN_COOKIES=y
# PACKET: gniazdo pakietowe na jednej karcie — DHCP przed nadaniem adresu (0.9.0 krok 6). Otwiera je tylko nadzorca
# (CAP_NET_RAW, net/packet/af_packet.c: packet_create) i przekazuje deskryptor usłudze „siec”. Bez PACKET_DIAG.
CONFIG_PACKET=y
# Sterowniki kart przewodowych (decyzje D0 i T6): szeroko, wbudowane — sterownik karty, której nie ma w komputerze,
# nigdy się nie uruchamia (jądro dobiera go po identyfikatorze PCI). Bez kart serwerowych 10G+ i bardzo starych.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
# ETHTOOL_NETLINK: wymagany przez IGC (drivers/net/ethernet/intel/Kconfig: depends on ETHTOOL_NETLINK); zmiany
# ustawień karty tylko z CAP_NET_ADMIN (nadzorca).
CONFIG_ETHTOOL_NETLINK=y
# Intel: e1000e — X230 (82579LM) i QEMU; e1000 — VirtualBox i stare karty; igb — I210/I211 płyt głównych;
# igc — I225/I226 (nowe laptopy i komputery); e100 — stare PRO/100.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y
CONFIG_E1000=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_E100=y
# Realtek: r8169 — RTL8101/8111/8168/8125 (IdeaPad 110-15ISK, większość laptopów; plik od producenta opcjonalny —
# bez niego karta działa, L12), 8139 — stare karty i niektóre maszyny wirtualne.
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
# Broadcom: tg3 — NetXtreme BCM57xx (laptopy Dell, HP, Apple).
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
# Qualcomm Atheros: alx — Killer E2xxx i AR816x; atl1c, atl1e, atl1 — starsze laptopy.
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_ATL1E=y
CONFIG_ATL1=y
# Marvell Yukon (sky2, skge), NVIDIA nForce (forcedeth), JMicron (jme), VIA Rhine — starsze laptopy i komputery.
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=y
CONFIG_SKGE=y
CONFIG_NET_VENDOR_NVIDIA=y
CONFIG_FORCEDETH=y
CONFIG_JME=y
CONFIG_NET_VENDOR_VIA=y
CONFIG_VIA_RHINE=y
# Maszyny wirtualne: virtio-net (QEMU/KVM), vmxnet3 (VMware); VirtualBox — e1000 wyżej. NET_CORE: menu, w którym
# są oba (drivers/net/Kconfig: if NET_CORE); bez bondingu, mostów, tun/tap i innych urządzeń wirtualnych z tego menu.
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VMXNET3=y
# Przejściówki USB–Ethernet: tylko popularne rodziny (podłączone urządzenie samo wybiera sterownik — RYZYKA R66):
# Realtek RTL8152/8153/8156, ASIX AX88772/AX88179, ogólne CDC ECM i CDC NCM (wiele przejściówek i stacji dokujących).
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y

# --- 0.9.1 Wi-Fi (ADR 0041; plan 0.9.1 krok 1) ---
# Wi-Fi jak kabel (ADR 0039): gniazdo nl80211 (generic netlink) otwiera tylko nadzorca — skanowanie, przełącznik,
# później łączenie i klucze wymagają CAP_NET_ADMIN (net/wireless/nl80211.c: GENL_UNS_ADMIN_PERM); to, co przychodzi
# z powietrza (opis sieci), czyta usługa „siec” w klatce. Żadna klatka nie ma socket (AF_NETLINK zabronione, t_proby).
# WIRELESS i CFG80211: interfejs jądra do kart Wi-Fi (net/wireless). Bez starego interfejsu „wireless extensions”
# (CFG80211_WEXT — ioctl SIOCSIW*), bez CRDA (CFG80211_CRDA_SUPPORT za EXPERT — program pomocniczy z uevent; bazę
# przepisów radiowych jądro wczytuje samo jak plik producenta, niżej).
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_WEXT is not set
# CONFIG_CFG80211_CRDA_SUPPORT is not set
# Baza przepisów radiowych (regulatory.db z wireless-regdb, wbudowana niżej): jądro sprawdza jej podpis PKCS#7 kluczem
# opiekunów bazy wbudowanym w źródła (net/wireless/certs) — CFG80211_REQUIRE_SIGNED_REGDB i USE_KERNEL_REGDB_KEYS mają
# pytanie tylko za CFG80211_CERTIFICATION_ONUS, więc działa ich „default y”; wybierają SYSTEM_DATA_VERIFICATION (kod
# podpisów: RSA, X.509, PKCS#7, klucze jądra — odstępstwo w docs/komponenty/jadro.md).
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
# MAC80211: wspólna część sterowników kart „miękkich” (prawie wszystkie karty w laptopach); sama wybiera kryptografię
# jądra do szyfrowania danych w powietrzu (CRYPTO_AES/CCM/GCM/CMAC — net/mac80211/Kconfig). Bez sieci „mesh”.
CONFIG_MAC80211=y
# CONFIG_MAC80211_MESH is not set
# Algorytm doboru prędkości nadawania (minstrel): bez niego mac80211 nie rejestruje kart, które go nie mają w sobie
# (ath9k, rtlwifi, rtw88, mt76, mac80211_hwsim — „Failed to select rate control algorithm”); za EXPERT, więc wprost.
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
# RFKILL: przełącznik radia — w obudowie (twardy) i programowy (Ustawienia → Sieć → Wi-Fi). Bez sterowania z klawiatury
# przez jądro (RFKILL_INPUT) — przełącznikiem zarządza nadzorca.
CONFIG_RFKILL=y
# CONFIG_RFKILL_INPUT is not set
# Sterowniki kart Wi-Fi PCIe (decyzje D0, T2): rodziny z laptopów; każda (poza ath9k) potrzebuje pliku od producenta —
# lista plików: jadro/oprogramowanie-kart.txt (decyzja D3), wbudowane przez EXTRA_FIRMWARE, które dopisuje
# scripts/zbuduj-jadro.sh. Karty Wi-Fi na USB — nie (RYZYKA), Broadcom — nie (T2).
CONFIG_WLAN=y
# Intel: iwlwifi — DVM (X230: Centrino 6205/6235/6300, Wireless-N 2200/2230) i MVM (7265, 8260/8265, 9260/9560,
# AX200/AX201, AX210/AX211). Bez IWLMLD (Wi-Fi 7, BE200 — później).
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
# Qualcomm Atheros: ath9k (802.11n, bez pliku; PCOEM — karty laptopów, za EXPERT), ath10k (QCA9377 — prawdopodobnie
# IdeaPad 110-15ISK, QCA6174).
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_PCOEM=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
# Realtek: rtlwifi (RTL8723BE, RTL8821AE — starsze laptopy), rtw88 (8822CE, 8822BE, 8821CE, 8723DE), rtw89 (8852BE).
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8723BE=y
CONFIG_RTL8821AE=y
CONFIG_RTW88=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8723DE=y
CONFIG_RTW89=y
CONFIG_RTW89_8852BE=y
# MediaTek: MT7921E (Wi-Fi 6 w nowszych laptopach, także AMD).
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
# Udawane karty Wi-Fi do testów (T5): mac80211_hwsim. W obrazie produkcyjnym nie tworzy żadnej karty — linia poleceń
# ma mac80211_hwsim.radios=0 (jadro/cmdline); karty w teście tworzy program testowy (HWSIM_CMD_NEW_RADIO, wymaga
# CAP_NET_ADMIN — tylko root: nadzorca i program testowy; nadzorca tego nigdy nie robi).
CONFIG_MAC80211_HWSIM=y

# --- M6b (ADR 0021): dm-verity — obraz rdzenia sprawdzany drzewem skrótów (SHA-256) ---
# Skrót główny w linii poleceń (k1.rdzen_skrot; od M6d w podpisanym UKI). Initramfs ustawia urządzenie
# dm-verity i czyta je w całości przed montowaniem: zmieniony bajt = zatrzymanie startu.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
# CONFIG_DM_VERITY_FEC is not set
# CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG is not set
# CONFIG_DM_UEVENT is not set
CONFIG_CRYPTO_SHA256=y

# --- Strefy (0.10.0, ADR 0042): KVM dla mikro-maszyn; maszynę tworzy VMM `strefa` z fd /dev/kvm od nadzorcy ---
# VIRTUALIZATION: menu KVM (samo nie dodaje kodu).
CONFIG_VIRTUALIZATION=y
# KVM: rdzeń (arch/x86/kvm); wbudowany — K1 nie ma modułów.
CONFIG_KVM=y
# KVM_INTEL: VT-x (X230, IdeaPad 110); wybiera X86_FRED.
CONFIG_KVM_INTEL=y
# KVM_AMD: AMD-V (SVM) — komputery z AMD i testy w emulacji (QEMU TCG udaje SVM z NPT, ADR 0042 T10).
CONFIG_KVM_AMD=y
# KVM_IOAPIC: kontroler przerwań i zegar PIT w jądrze (KVM_CREATE_IRQCHIP, KVM_CREATE_PIT2) — „default y”, który
# allnoconfig wyłącza; bez niego VMM musiałby sam udawać przerwania.
CONFIG_KVM_IOAPIC=y
# Bez emulacji SMM (firmware UEFI gościa), Hyper-V, Xen, SGX dla gości i szyfrowanych maszyn AMD — gość K1 startuje
# jądro wprost, bez firmware; mniej kodu w jądrze.
# CONFIG_KVM_SMM is not set
# CONFIG_KVM_HYPERV is not set
# CONFIG_KVM_XEN is not set
# CONFIG_X86_SGX_KVM is not set
# CONFIG_KVM_AMD_SEV is not set
# CONFIG_KVM_INTEL_TDX is not set
# CONFIG_KVM_SW_PROTECTED_VM is not set
